%YAML 1.2
---
name: Excel
file_extensions: [excel, xls, xlsx]
scope: source.excel
contexts:
  main:
    - match: '"'
      push:
        - meta_scope: string.quoted.double.excel
        - match: '""'
        - match: '"'
          pop: true
    - match: "'"
      push:
        - meta_scope: string.quoted.single.excel
        - match: "''"
        - match: "'"
          pop: true
    - match: '(?i)\b[A-Z_][A-Z\d_.]*(?=\s*\()'
      scope: support.function.excel
    - match: '(?i)\$?[A-Z]{1,3}\$?\d+\b'
      scope: variable.other.excel
    - match: '(?i)\b(TRUE|FALSE)\b|\b\d+(\.\d+)?([Ee][+-]?\d+)?%?'
      scope: constant.numeric.excel
    - match: '#[A-Z0-9/]+[!?]?'
      scope: constant.language.error.excel
    - match: '[+*/^&=<>%:-]'
      scope: keyword.operator.excel
