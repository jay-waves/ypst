{
  "Document template": {
    "prefix": "doc",
    "body": [
      "#import \"@local/ypst-template:0.1.0\" as theme",
      "#import theme: template, sidenote, theorem, lemma, corollary, definition, proof",
      "",
      "#show: template",
      "",
      "#set document(",
      "  title: \"Title\",",
      "  date: datetime.today(),",
      "  keywords: (\"keyword\",)",
      ")",
      ""
    ]
  },
  "Theorem": {
    "prefix": "thm",
    "body": [
      "#theorem[",
      "  Theorem.",
      "]"
    ]
  },
  "Lemma": {
    "prefix": "lem",
    "body": [
      "#lemma[",
      "  Lemma.",
      "]"
    ]
  },
  "Corollary": {
    "prefix": "cor",
    "body": [
      "#corollary[",
      "  Corollary.",
      "]"
    ]
  },
  "Definition": {
    "prefix": "def",
    "body": [
      "#definition[",
      "  Definition.",
      "]"
    ]
  },
  "Proof": {
    "prefix": "proof",
    "body": [
      "#proof[",
      "  Proof.",
      "]"
    ]
  },
  "Sidenote": {
    "prefix": "side",
    "body": [
      "#sidenote[",
      "  Main text.",
      "][",
      "  Side note.",
      "]"
    ]
  },
  "Sidenote with image": {
    "prefix": "sideimg",
    "body": [
      "#sidenote(",
      "  side-image: \"image.png\",",
      ")[",
      "  Main text.",
      "][",
      "  Side note.",
      "]"
    ]
  },
  "Multiline equation group": {
    "prefix": "eql",
    "body": [
      "$",
      "  a &= b + c && \"(a)\" \\",
      "  d &= e + f && \"(b)\"",
      "$ <eq:group>"
    ]
  }
}
